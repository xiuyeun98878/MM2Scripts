-- Infinite loading animation
task.spawn(function()
	local messages = {
		"Loading GUI",
		"Loading scripts",
		"Loading assets",
		"Loading modules",
		"Initializing interface",
		"Preparing Murder Mystery 2",
		"Waiting for resources",
		"Almost ready"
	}

	local index = 1

	while true do
		-- Text animation
		for dots = 0, 3 do
			loading.Text = messages[index] .. string.rep(".", dots)
			task.wait(0.35)
		end

		index += 1
		if index > #messages then
			index = 1
		end
	end
end)

